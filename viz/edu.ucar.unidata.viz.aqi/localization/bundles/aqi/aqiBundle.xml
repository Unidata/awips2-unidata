<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<bundle>
	<displayList>
		<displays xsi:type="d2DMapRenderableDisplay" density="1.0"
			magnification="1.0" zoomLevel="1.0"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
			<descriptor xsi:type="mapDescriptor">
				<resource>
					<properties isSystemResource="false" isBlinking="false"
						isMapLayer="false" isHoverOn="false" isVisible="true" />
					<resourceData xsi:type="aqiResourceData"
						retrieveData="true" isUpdatingOnMetadataOnly="false"
						isRequeryNecessaryOnTimeMatch="true">
						<metadataMap>
							<mapping key="pluginName">
								<constraint constraintValue="aqi"
									constraintType="EQUALS" />
							</mapping>
						</metadataMap>
					</resourceData>
				</resource>
			</descriptor>
		</displays>
	</displayList>
</bundle>